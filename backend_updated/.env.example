# --- App ---
APP_NAME="مهارة"
ENVIRONMENT=development        # development | production
DEBUG=true

# --- Database ---
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/service_marketplace

# --- JWT ---
# This signs every login token, so leaving it at the value below means anyone
# who has read this file can forge a token for any account. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins (Flutter web/dev origins etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Firebase Cloud Messaging (push notifications) ---
# The service account JSON is NOT in this repository: it holds a private key.
# Download your own from Firebase Console > Project settings > Service accounts
# > Generate new private key, and save it at the path below. The path is
# relative to wherever you run `uvicorn` from (normally the backend directory).
# See FIREBASE_SETUP.md.
#
# Left disabled so the server runs correctly without that file. Every other
# feature works; only push notifications to a phone are skipped — the in-app
# notification list is written to the database either way. Set it to true once
# your own service account file is in place.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FCM_ENABLED=false

# --- Semantic (AI) search ---
# Requires `pip install sentence-transformers` (heavy: pulls in torch).
# See SEMANTIC_SEARCH_SETUP.md.
SEMANTIC_SEARCH_ENABLED=false

# --- Pagination defaults ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Email (for "forgot password") ---
# Leave SMTP_HOST empty in development: no email is sent, the reset code is
# printed in the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an "App Password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=مهارة
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60
